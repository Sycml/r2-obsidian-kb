{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "r2-obsidian-kb",
  "main": "worker/index.ts",
  "compatibility_date": "2025-04-01",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [
    {
      "binding": "NOTES_BUCKET",
      "bucket_name": "my-obsidian-notes"
    }
  ],
  "vars": {
    // 认证模式: "password" (应用内口令登录，默认) | "cloudflare-access" (Zero Trust Access) | "none" (仅公开或调试)
    "AUTH_MODE": "password",
    // 若笔记放在存储桶子目录下，例如 "obsidian/"，填在这里；根目录留空即可
    "VAULT_PREFIX": "",
    // 知识库站点标题
    "SITE_TITLE": "我的知识库",
    // 会话有效期（小时），默认 168 小时 (7 天)
    "SESSION_TTL_HOURS": "168",
    // 可选：使用 cloudflare-access 模式并开启 JWT 签名验证时填写
    "CF_ACCESS_TEAM_DOMAIN": "",
    "CF_ACCESS_AUD": ""
  }
}
